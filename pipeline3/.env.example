# Environment Variables for Pipeline 3
# Copy this file to .env and fill in your API keys

# FPT.AI API Key (for STT and TTS)
# Get from: https://fpt.ai/
FPT_API_KEY=your_fpt_api_key_here

# OpenAI API Key (for Whisper STT backup)
# Get from: https://platform.openai.com/
OPENAI_API_KEY=your_openai_api_key_here

# Google Gemini API Key (for LLM)
# Get from: https://ai.google.dev/
GEMINI_API_KEY=your_gemini_api_key_here

# Google Cloud Service Account JSON path (for TTS backup)
# Download JSON file from Google Cloud Console and put the path here
GOOGLE_CLOUD_JSON_PATH=path/to/your/service-account.json
